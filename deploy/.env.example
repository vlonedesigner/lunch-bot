# Скопировать в .env рядом с docker-compose.yml и заполнить. .env в git не коммитится.

# логин Docker Hub, откуда тянуть образ <логин>/lunch-bot:latest
DOCKERHUB_USERNAME=

# токен от @BotFather
BOT_TOKEN=

# ID Google-таблицы (из ссылки docs.google.com/spreadsheets/d/<ID>/...)
SHEET_ID=

# необязательные
NOTIFY_TIME=15:00
TZ_NAME=Europe/Moscow
NOTIFY_ON_EMPTY_DAYS=0
# листы с правильной структурой, которые не являются сотрудниками
EXCLUDE_SHEETS=Шаблон
